# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/cms-guide
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
# Set to true when served over HTTPS (defaults to true in production)
# COOKIE_SECURE=true

# ── Media storage (S3) ─────────────────────────────────
# Leave AWS_S3_BUCKET empty to store uploads on local disk (development only).
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: serve media through CloudFront, e.g. https://d123abc.cloudfront.net
CLOUDFRONT_URL=
# Optional: S3-compatible endpoint (MinIO, LocalStack)
# S3_ENDPOINT=http://localhost:9000
LOCAL_UPLOAD_DIR=./uploads

# ── Search ─────────────────────────────────────────────
# Name of a MongoDB Atlas Search index on the modules and subtasks collections.
# Leave empty to use the built-in text index.
ATLAS_SEARCH_INDEX=

# ── Seed ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
